# @gyronimo-config, this file is part of ::gyronimo::

GYRONIMO_INCLUDE_DIRS="@GYRONIMO_INCLUDE_DIRS@"
GYRONIMO_LIBRARIES="@GYRONIMO_LIBRARIES@"

while getopts ":ILlh" OPT; do
  case ${OPT} in
    I ) echo "${GYRONIMO_INCLUDE_DIRS}";;
    l ) echo "${GYRONIMO_LIBRARIES}";;
    h|\? ) echo "usage: gyronimo-config [-I] [-l]";;
  esac
done
